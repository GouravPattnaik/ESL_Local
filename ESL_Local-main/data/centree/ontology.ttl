@prefix ex: <https://example.org/esa/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology declaration ──────────────────────────────────────────────────────
ex:ESAExampleOntology a owl:Ontology ;
    rdfs:label "ESA sample ontology – replace with authorized CENtree export" .

# ── Classes ───────────────────────────────────────────────────────────────────
ex:Customer a owl:Class ; rdfs:label "Customer" .
ex:Account  a owl:Class ; rdfs:label "Account" .
ex:Loan     a owl:Class ; rdfs:label "Loan" .
ex:Branch   a owl:Class ; rdfs:label "Branch" .

# ── Object Properties (relationships between nodes) ───────────────────────────
ex:ownsAccount   a owl:ObjectProperty ; rdfs:domain ex:Customer ; rdfs:range ex:Account ; rdfs:label "owns account" .
ex:hasLoan       a owl:ObjectProperty ; rdfs:domain ex:Customer ; rdfs:range ex:Loan    ; rdfs:label "has loan" .
ex:registeredAt  a owl:ObjectProperty ; rdfs:domain ex:Customer ; rdfs:range ex:Branch  ; rdfs:label "registered at branch" .
ex:securedBy     a owl:ObjectProperty ; rdfs:domain ex:Loan     ; rdfs:range ex:Account ; rdfs:label "secured by account" .

# ── Datatype Properties (attributes on nodes) ─────────────────────────────────
ex:customerId    a owl:DatatypeProperty ; rdfs:domain ex:Customer ; rdfs:range xsd:string  ; rdfs:label "customer ID" .
ex:fullName      a owl:DatatypeProperty ; rdfs:domain ex:Customer ; rdfs:range xsd:string  ; rdfs:label "full name" .
ex:email         a owl:DatatypeProperty ; rdfs:domain ex:Customer ; rdfs:range xsd:string  ; rdfs:label "email" .
ex:phone         a owl:DatatypeProperty ; rdfs:domain ex:Customer ; rdfs:range xsd:string  ; rdfs:label "phone" .
ex:creditScore   a owl:DatatypeProperty ; rdfs:domain ex:Customer ; rdfs:range xsd:integer ; rdfs:label "credit score" .
ex:accountId     a owl:DatatypeProperty ; rdfs:domain ex:Account  ; rdfs:range xsd:string  ; rdfs:label "account ID" .
ex:accountType   a owl:DatatypeProperty ; rdfs:domain ex:Account  ; rdfs:range xsd:string  ; rdfs:label "account type" .
ex:balance       a owl:DatatypeProperty ; rdfs:domain ex:Account  ; rdfs:range xsd:decimal ; rdfs:label "balance" .
ex:accountStatus a owl:DatatypeProperty ; rdfs:domain ex:Account  ; rdfs:range xsd:string  ; rdfs:label "account status" .
ex:loanId        a owl:DatatypeProperty ; rdfs:domain ex:Loan     ; rdfs:range xsd:string  ; rdfs:label "loan ID" .
ex:loanType      a owl:DatatypeProperty ; rdfs:domain ex:Loan     ; rdfs:range xsd:string  ; rdfs:label "loan type" .
ex:loanAmount    a owl:DatatypeProperty ; rdfs:domain ex:Loan     ; rdfs:range xsd:decimal ; rdfs:label "loan amount" .
ex:loanStatus    a owl:DatatypeProperty ; rdfs:domain ex:Loan     ; rdfs:range xsd:string  ; rdfs:label "loan status" .
ex:interestRate  a owl:DatatypeProperty ; rdfs:domain ex:Loan     ; rdfs:range xsd:decimal ; rdfs:label "interest rate" .
ex:branchId      a owl:DatatypeProperty ; rdfs:domain ex:Branch   ; rdfs:range xsd:string  ; rdfs:label "branch ID" .
