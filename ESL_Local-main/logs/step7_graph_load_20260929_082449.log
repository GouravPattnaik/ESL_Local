08:24:55  INFO      step7.graph_load --   // Neo4j Cypher — sample queries (run in Neo4j Browser at http://localhost:7474)
08:24:55  INFO      step7.graph_load --   
08:24:55  INFO      step7.graph_load --     // Count all RDF nodes
08:24:55  INFO      step7.graph_load --     MATCH (n:RDFTerm) RETURN count(n) AS total_nodes;
08:24:55  INFO      step7.graph_load --   
08:24:55  INFO      step7.graph_load --     // Find customer C001 and all related nodes
08:24:55  INFO      step7.graph_load --     MATCH (c:RDFTerm {iri: "https://example.org/esa/customer/C001"})-[r]->(x)
08:24:55  INFO      step7.graph_load --     RETURN c.iri, r.predicate, x.value LIMIT 20;
08:24:55  INFO      step7.graph_load --   
08:24:55  INFO      step7.graph_load --     // Find all loans linked to any customer
08:24:55  INFO      step7.graph_load --     MATCH (c:RDFTerm)-[r:RDF_REL {predicate: "https://example.org/esa/hasLoan"}]->(l:RDFTerm)
08:24:55  INFO      step7.graph_load --     RETURN c.iri AS customer, l.iri AS loan LIMIT 20;
08:24:55  INFO      step7.graph_load -- 
08:24:55  INFO      step7.graph_load --   ── AWS Neptune SPARQL (Neptune endpoint) ───────────────────────
08:24:55  INFO      step7.graph_load --   # Neptune SPARQL — equivalent queries via SPARQL endpoint
08:24:55  INFO      step7.graph_load --   
08:24:55  INFO      step7.graph_load --     # Find all customers and their credit scores
08:24:55  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
08:24:55  INFO      step7.graph_load --     SELECT ?customer ?name ?score WHERE {
08:24:55  INFO      step7.graph_load --       ?customer a ex:Customer ;
08:24:55  INFO      step7.graph_load --                 ex:fullName ?name ;
08:24:55  INFO      step7.graph_load --                 ex:creditScore ?score .
08:24:55  INFO      step7.graph_load --     } ORDER BY DESC(?score)
08:24:55  INFO      step7.graph_load --   
08:24:55  INFO      step7.graph_load --     # Find all loans for a specific customer
08:24:55  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
08:24:55  INFO      step7.graph_load --     SELECT ?loan ?type ?amount WHERE {
08:24:55  INFO      step7.graph_load --       ex:customer/C001 ex:hasLoan ?loan .
08:24:55  INFO      step7.graph_load --       ?loan ex:loanType ?type ;
08:24:55  INFO      step7.graph_load --             ex:loanAmount ?amount .
08:24:55  INFO      step7.graph_load --     }
08:24:55  INFO      step7.graph_load --   
08:24:55  INFO      step7.graph_load --     # Customers with credit score < 700 and their loans
08:24:55  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
08:24:55  INFO      step7.graph_load --     SELECT ?name ?score ?loanId ?amount WHERE {
08:24:55  INFO      step7.graph_load --       ?c a ex:Customer ;
08:24:55  INFO      step7.graph_load --          ex:fullName ?name ;
08:24:55  INFO      step7.graph_load --          ex:creditScore ?score ;
08:24:55  INFO      step7.graph_load --          ex:hasLoan ?loan .
08:24:55  INFO      step7.graph_load --       ?loan ex:loanId ?loanId ;
08:24:55  INFO      step7.graph_load --             ex:loanAmount ?amount .
08:24:55  INFO      step7.graph_load --       FILTER(?score < 700)
08:24:55  INFO      step7.graph_load --     }
