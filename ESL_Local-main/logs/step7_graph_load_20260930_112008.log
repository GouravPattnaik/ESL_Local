11:20:16  INFO      step7.graph_load --   ── LOCAL Neo4j Cypher (http://localhost:7474) ──────────────────
11:20:16  INFO      step7.graph_load --   // Neo4j Cypher -- sample queries (run in Neo4j Browser at http://localhost:7474)
11:20:16  INFO      step7.graph_load --     // NOTE: These use TYPED nodes -- requires load_nquads_typed() (step7 default).
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     // 1. Count all entity types
11:20:16  INFO      step7.graph_load --     MATCH (n) RETURN labels(n)[0] AS type, count(n) AS total ORDER BY total DESC;
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     // 2. Find a specific customer and all their details
11:20:16  INFO      step7.graph_load --     MATCH (c:Customer {id: 'C001'})
11:20:16  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:OWNS_ACCOUNT]->(a:Account)
11:20:16  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:HAS_LOAN]->(l:Loan)
11:20:16  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:REGISTERED_AT]->(b:Branch)
11:20:16  INFO      step7.graph_load --     RETURN c.fullName, c.creditScore, collect(DISTINCT a.accountType) AS accounts,
11:20:16  INFO      step7.graph_load --            collect(DISTINCT l.loanType) AS loans, b.branchId;
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     // 3. All customers with their credit scores (sorted high to low)
11:20:16  INFO      step7.graph_load --     MATCH (c:Customer)
11:20:16  INFO      step7.graph_load --     RETURN c.id, c.fullName, c.creditScore
11:20:16  INFO      step7.graph_load --     ORDER BY c.creditScore DESC;
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     // 4. Customers with credit score below 700 and their loan amounts
11:20:16  INFO      step7.graph_load --     MATCH (c:Customer)-[:HAS_LOAN]->(l:Loan)
11:20:16  INFO      step7.graph_load --     WHERE c.creditScore < 700
11:20:16  INFO      step7.graph_load --     RETURN c.fullName, c.creditScore, l.loanType, l.loanAmount
11:20:16  INFO      step7.graph_load --     ORDER BY c.creditScore;
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     // 5. Total loan amount per branch
11:20:16  INFO      step7.graph_load --     MATCH (c:Customer)-[:REGISTERED_AT]->(b:Branch)
11:20:16  INFO      step7.graph_load --     MATCH (c)-[:HAS_LOAN]->(l:Loan)
11:20:16  INFO      step7.graph_load --     RETURN b.branchId, count(l) AS loans, sum(l.loanAmount) AS total_amount
11:20:16  INFO      step7.graph_load --     ORDER BY total_amount DESC;
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     // 6. Full graph -- visualise in Neo4j Browser (limit for readability)
11:20:16  INFO      step7.graph_load --     MATCH path = (c:Customer)-[*1..2]->()
11:20:16  INFO      step7.graph_load --     RETURN path LIMIT 50;
11:20:16  INFO      step7.graph_load -- 
11:20:16  INFO      step7.graph_load --   ── AWS Neptune SPARQL (Neptune endpoint) ───────────────────────
11:20:16  INFO      step7.graph_load --   # Neptune SPARQL — equivalent queries via SPARQL endpoint
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     # Find all customers and their credit scores
11:20:16  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
11:20:16  INFO      step7.graph_load --     SELECT ?customer ?name ?score WHERE {
11:20:16  INFO      step7.graph_load --       ?customer a ex:Customer ;
11:20:16  INFO      step7.graph_load --                 ex:fullName ?name ;
11:20:16  INFO      step7.graph_load --                 ex:creditScore ?score .
11:20:16  INFO      step7.graph_load --     } ORDER BY DESC(?score)
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     # Find all loans for a specific customer
11:20:16  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
11:20:16  INFO      step7.graph_load --     SELECT ?loan ?type ?amount WHERE {
11:20:16  INFO      step7.graph_load --       ex:customer/C001 ex:hasLoan ?loan .
11:20:16  INFO      step7.graph_load --       ?loan ex:loanType ?type ;
11:20:16  INFO      step7.graph_load --             ex:loanAmount ?amount .
11:20:16  INFO      step7.graph_load --     }
11:20:16  INFO      step7.graph_load --   
11:20:16  INFO      step7.graph_load --     # Customers with credit score < 700 and their loans
11:20:16  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
11:20:16  INFO      step7.graph_load --     SELECT ?name ?score ?loanId ?amount WHERE {
11:20:16  INFO      step7.graph_load --       ?c a ex:Customer ;
11:20:16  INFO      step7.graph_load --          ex:fullName ?name ;
11:20:16  INFO      step7.graph_load --          ex:creditScore ?score ;
11:20:16  INFO      step7.graph_load --          ex:hasLoan ?loan .
11:20:16  INFO      step7.graph_load --       ?loan ex:loanId ?loanId ;
11:20:16  INFO      step7.graph_load --             ex:loanAmount ?amount .
11:20:16  INFO      step7.graph_load --       FILTER(?score < 700)
11:20:16  INFO      step7.graph_load --     }
