15:24:26  INFO      step7.graph_load -- ▶ Sample queries for exploration:
15:24:26  INFO      step7.graph_load -- 
15:24:26  INFO      step7.graph_load --   ── LOCAL Neo4j Cypher (http://localhost:7474) ──────────────────
15:24:26  INFO      step7.graph_load --   // Neo4j Cypher -- sample queries (run in Neo4j Browser at http://localhost:7474)
15:24:26  INFO      step7.graph_load --     // NOTE: These use TYPED nodes -- requires load_nquads_typed() (step7 default).
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     // 1. Count all entity types
15:24:26  INFO      step7.graph_load --     MATCH (n) RETURN labels(n)[0] AS type, count(n) AS total ORDER BY total DESC;
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     // 2. Find a specific customer and all their details
15:24:26  INFO      step7.graph_load --     MATCH (c:Customer {id: 'C001'})
15:24:26  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:OWNS_ACCOUNT]->(a:Account)
15:24:26  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:HAS_LOAN]->(l:Loan)
15:24:26  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:REGISTERED_AT]->(b:Branch)
15:24:26  INFO      step7.graph_load --     RETURN c.fullName, c.creditScore, collect(DISTINCT a.accountType) AS accounts,
15:24:26  INFO      step7.graph_load --            collect(DISTINCT l.loanType) AS loans, b.branchId;
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     // 3. All customers with their credit scores (sorted high to low)
15:24:26  INFO      step7.graph_load --     MATCH (c:Customer)
15:24:26  INFO      step7.graph_load --     RETURN c.id, c.fullName, c.creditScore
15:24:26  INFO      step7.graph_load --     ORDER BY c.creditScore DESC;
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     // 4. Customers with credit score below 700 and their loan amounts
15:24:26  INFO      step7.graph_load --     MATCH (c:Customer)-[:HAS_LOAN]->(l:Loan)
15:24:26  INFO      step7.graph_load --     WHERE c.creditScore < 700
15:24:26  INFO      step7.graph_load --     RETURN c.fullName, c.creditScore, l.loanType, l.loanAmount
15:24:26  INFO      step7.graph_load --     ORDER BY c.creditScore;
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     // 5. Total loan amount per branch
15:24:26  INFO      step7.graph_load --     MATCH (c:Customer)-[:REGISTERED_AT]->(b:Branch)
15:24:26  INFO      step7.graph_load --     MATCH (c)-[:HAS_LOAN]->(l:Loan)
15:24:26  INFO      step7.graph_load --     RETURN b.branchId, count(l) AS loans, sum(l.loanAmount) AS total_amount
15:24:26  INFO      step7.graph_load --     ORDER BY total_amount DESC;
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     // 6. Full graph -- visualise in Neo4j Browser (limit for readability)
15:24:26  INFO      step7.graph_load --     MATCH path = (c:Customer)-[*1..2]->()
15:24:26  INFO      step7.graph_load --     RETURN path LIMIT 50;
15:24:26  INFO      step7.graph_load -- 
15:24:26  INFO      step7.graph_load --   ── AWS Neptune SPARQL (Neptune endpoint) ───────────────────────
15:24:26  INFO      step7.graph_load --   # Neptune SPARQL — equivalent queries via SPARQL endpoint
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     # Find all customers and their credit scores
15:24:26  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
15:24:26  INFO      step7.graph_load --     SELECT ?customer ?name ?score WHERE {
15:24:26  INFO      step7.graph_load --       ?customer a ex:Customer ;
15:24:26  INFO      step7.graph_load --                 ex:fullName ?name ;
15:24:26  INFO      step7.graph_load --                 ex:creditScore ?score .
15:24:26  INFO      step7.graph_load --     } ORDER BY DESC(?score)
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     # Find all loans for a specific customer
15:24:26  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
15:24:26  INFO      step7.graph_load --     SELECT ?loan ?type ?amount WHERE {
15:24:26  INFO      step7.graph_load --       ex:customer/C001 ex:hasLoan ?loan .
15:24:26  INFO      step7.graph_load --       ?loan ex:loanType ?type ;
15:24:26  INFO      step7.graph_load --             ex:loanAmount ?amount .
15:24:26  INFO      step7.graph_load --     }
15:24:26  INFO      step7.graph_load --   
15:24:26  INFO      step7.graph_load --     # Customers with credit score < 700 and their loans
15:24:26  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
15:24:26  INFO      step7.graph_load --     SELECT ?name ?score ?loanId ?amount WHERE {
15:24:26  INFO      step7.graph_load --       ?c a ex:Customer ;
15:24:26  INFO      step7.graph_load --          ex:fullName ?name ;
15:24:26  INFO      step7.graph_load --          ex:creditScore ?score ;
15:24:26  INFO      step7.graph_load --          ex:hasLoan ?loan .
15:24:26  INFO      step7.graph_load --       ?loan ex:loanId ?loanId ;
15:24:26  INFO      step7.graph_load --             ex:loanAmount ?amount .
15:24:26  INFO      step7.graph_load --       FILTER(?score < 700)
15:24:26  INFO      step7.graph_load --     }
15:24:26  INFO      step7.graph_load -- 
