09:11:34  INFO      step7.graph_load --   ── LOCAL Neo4j Cypher (http://localhost:7474) ──────────────────
09:11:34  INFO      step7.graph_load --   // Neo4j Cypher -- sample queries (run in Neo4j Browser at http://localhost:7474)
09:11:34  INFO      step7.graph_load --     // NOTE: These use TYPED nodes -- requires load_nquads_typed() (step7 default).
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     // 1. Count all entity types
09:11:34  INFO      step7.graph_load --     MATCH (n) RETURN labels(n)[0] AS type, count(n) AS total ORDER BY total DESC;
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     // 2. Find a specific customer and all their details
09:11:34  INFO      step7.graph_load --     MATCH (c:Customer {id: 'C001'})
09:11:34  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:OWNS_ACCOUNT]->(a:Account)
09:11:34  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:HAS_LOAN]->(l:Loan)
09:11:34  INFO      step7.graph_load --     OPTIONAL MATCH (c)-[:REGISTERED_AT]->(b:Branch)
09:11:34  INFO      step7.graph_load --     RETURN c.fullName, c.creditScore, collect(DISTINCT a.accountType) AS accounts,
09:11:34  INFO      step7.graph_load --            collect(DISTINCT l.loanType) AS loans, b.branchId;
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     // 3. All customers with their credit scores (sorted high to low)
09:11:34  INFO      step7.graph_load --     MATCH (c:Customer)
09:11:34  INFO      step7.graph_load --     RETURN c.id, c.fullName, c.creditScore
09:11:34  INFO      step7.graph_load --     ORDER BY c.creditScore DESC;
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     // 4. Customers with credit score below 700 and their loan amounts
09:11:34  INFO      step7.graph_load --     MATCH (c:Customer)-[:HAS_LOAN]->(l:Loan)
09:11:34  INFO      step7.graph_load --     WHERE c.creditScore < 700
09:11:34  INFO      step7.graph_load --     RETURN c.fullName, c.creditScore, l.loanType, l.loanAmount
09:11:34  INFO      step7.graph_load --     ORDER BY c.creditScore;
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     // 5. Total loan amount per branch
09:11:34  INFO      step7.graph_load --     MATCH (c:Customer)-[:REGISTERED_AT]->(b:Branch)
09:11:34  INFO      step7.graph_load --     MATCH (c)-[:HAS_LOAN]->(l:Loan)
09:11:34  INFO      step7.graph_load --     RETURN b.branchId, count(l) AS loans, sum(l.loanAmount) AS total_amount
09:11:34  INFO      step7.graph_load --     ORDER BY total_amount DESC;
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     // 6. Full graph -- visualise in Neo4j Browser (limit for readability)
09:11:34  INFO      step7.graph_load --     MATCH path = (c:Customer)-[*1..2]->()
09:11:34  INFO      step7.graph_load --     RETURN path LIMIT 50;
09:11:34  INFO      step7.graph_load -- 
09:11:34  INFO      step7.graph_load --   ── AWS Neptune SPARQL (Neptune endpoint) ───────────────────────
09:11:34  INFO      step7.graph_load --   # Neptune SPARQL — equivalent queries via SPARQL endpoint
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     # Find all customers and their credit scores
09:11:34  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
09:11:34  INFO      step7.graph_load --     SELECT ?customer ?name ?score WHERE {
09:11:34  INFO      step7.graph_load --       ?customer a ex:Customer ;
09:11:34  INFO      step7.graph_load --                 ex:fullName ?name ;
09:11:34  INFO      step7.graph_load --                 ex:creditScore ?score .
09:11:34  INFO      step7.graph_load --     } ORDER BY DESC(?score)
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     # Find all loans for a specific customer
09:11:34  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
09:11:34  INFO      step7.graph_load --     SELECT ?loan ?type ?amount WHERE {
09:11:34  INFO      step7.graph_load --       ex:customer/C001 ex:hasLoan ?loan .
09:11:34  INFO      step7.graph_load --       ?loan ex:loanType ?type ;
09:11:34  INFO      step7.graph_load --             ex:loanAmount ?amount .
09:11:34  INFO      step7.graph_load --     }
09:11:34  INFO      step7.graph_load --   
09:11:34  INFO      step7.graph_load --     # Customers with credit score < 700 and their loans
09:11:34  INFO      step7.graph_load --     PREFIX ex: <https://example.org/esa/>
09:11:34  INFO      step7.graph_load --     SELECT ?name ?score ?loanId ?amount WHERE {
09:11:34  INFO      step7.graph_load --       ?c a ex:Customer ;
09:11:34  INFO      step7.graph_load --          ex:fullName ?name ;
09:11:34  INFO      step7.graph_load --          ex:creditScore ?score ;
09:11:34  INFO      step7.graph_load --          ex:hasLoan ?loan .
09:11:34  INFO      step7.graph_load --       ?loan ex:loanId ?loanId ;
09:11:34  INFO      step7.graph_load --             ex:loanAmount ?amount .
09:11:34  INFO      step7.graph_load --       FILTER(?score < 700)
09:11:34  INFO      step7.graph_load --     }
