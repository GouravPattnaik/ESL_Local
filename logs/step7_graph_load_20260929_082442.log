08:24:42  INFO      step7.graph_load --     RETURN c.iri, r.predicate, x.value LIMIT 20;
08:24:42  INFO      step7.graph_load --   
08:24:42  INFO      step7.graph_load --     // Find all loans linked to any customer
08:24:42  INFO      step7.graph_load --     MATCH (c:RDFTerm)-[r:RDF_REL {predicate: "https://example.org/esa/hasLoan"}]->(l:RDFTerm)
08:24:42  INFO      step7.graph_load --     RETURN c.iri AS customer, l.iri AS loan LIMIT 20;
