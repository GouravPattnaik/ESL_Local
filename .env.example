# Local storage
LOCAL_BUCKET_DIR=local_bucket
CENTREE_TTL_PATH=data/centree/ontology.ttl
SHACL_SHAPES_PATH=data/shapes/ontology_shapes.ttl
DOCS_DIR=data/documents
STRUCTURED_DATA_PATH=data/records
RDF_OUTPUT_KEY=knowledge/abox/instances.nq

# Embeddings: local | openai
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=none
OPENAI_CHAT_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# Configuration Scenarios:
# 1. Local dev (no AWS)
#    VECTOR_STORE=chromadb
#    EMBEDDING_PROVIDER=local
# 2. Local dev with OpenAI embeddings
#    VECTOR_STORE=chromadb
#    EMBEDDING_PROVIDER=openai
# 3. AWS production
#    VECTOR_STORE=opensearch
#    EMBEDDING_PROVIDER=openai
# -------------------------------------------------------------
# Vector Store: chromadb (local, free) | opensearch (AWS, production)
VECTOR_STORE=chromadb

# Chroma (used when VECTOR_STORE=chromadb)
CHROMA_DIR=local_bucket/vectorstore/chroma
CHROMA_COLLECTION=esa_documents

# Neo4j optional
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# AWS alternatives (used when VECTOR_STORE=opensearch or S3 storage enabled)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_INPUT_PREFIX=source/
S3_OUTPUT_PREFIX=artifacts/
OPENSEARCH_HOST=search-your-domain-xxxxx.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=esa_documents

# Amazon Neptune (AWS Graph DB - commented / optional)
# NEPTUNE_ENDPOINT=your-neptune-cluster.cluster-custom.us-east-1.neptune.amazonaws.com
# NEPTUNE_PORT=8182
# NEPTUNE_PROTOCOL=https
# NEPTUNE_LOAD_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/NeptuneLoadFromS3Role
# NEPTUNE_USE_IAM_AUTH=false
